# ==============================================================================
# MessMate Frontend Environment Variables (Example Template)
# Copy this file to .env and configure for local or production deployment.
# ==============================================================================

# API Base URL (default '/api' connects via Vite proxy in development)
VITE_API_BASE_URL=/api

# Backend Server URL (Render cloud backend or local)
VITE_BACKEND_URL=https://messmate-backend-nn3j.onrender.com

# Application Branding
VITE_APP_NAME=MessMate
